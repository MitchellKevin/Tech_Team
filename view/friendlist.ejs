<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Potential Matches</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

  <header>
    <%- include('partials/header'); %>
  </header>

    <div class="match-container">
        <div class="user-info">
            <img id="user-photo" src="<%= user.avatar %>" alt="Profielfoto">
            <div>
                <h3 id="user-name"><%= user.name %></h3>
                <p id="user-country">🇳🇱 Nederland</p>
            </div>
        </div>

        <!-- Matches sectie -->
        <section class="matches">
            <h1>Potential Matches</h1>
            <br>
            <h2>Friendrequest</h2>
            <br>
            <ul>
              <% potentialMatches.forEach(match => { %>
                <li>
                  <strong><%= match.name %></strong> - Favorites: 
                  <% if (match.fav && Array.isArray(match.fav)) { %>
                    <%= match.fav.join(", ") %>
                  <% } else { %>
                    Geen favorieten
                  <% } %>
                  <form action="/friendrequest/respond" method="POST">
                    <input type="hidden" name="requesterId" value="<%= match._id %>">
                    <button type="submit" name="action" value="accept">Accepteer</button>
                    <button type="submit" name="action" value="reject">Weiger</button>
                  </form>
                </li>
              <% }) %>
            </ul>

            <a href="/friends">
              <button>
                Bekijk je vrienden
              </button>
            </a>
        </section>
    </div>
    <footer>
      <%- include('../partials/footer'); %>
  </footer>
</body>
</html>