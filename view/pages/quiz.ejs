<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>quiz</title>
    <link rel="stylesheet" href="style.css">

</head>

<body>

    <header>
        <%- include('../partials/header'); %>
    </header>


    <section class="quiz">

        <div id="knopterug">
            <a href="/" id="terug-link">← Terug naar home</a> / <span id="quiz-titel">Matching quiz</span>
        </div>

        <h1>Vind jouw match </h1>

        <div class="progressContainer">
            <progress id="progressBar" value="0" max="100"></progress>
        </div>

        <form action="#" method="post" id="vragenlijst">
            <!-- Vraag 1 -->
            <div class="vraag actief" id="vraag1-container">
                <p class="vraag-teller" id="vraag-teller">Vraag 1 van 6</p>
                <label for="vraag1">Hoe lang wil je reizen?</label>
                <br><br>
                <div id="vraag1">
                    <input type="radio" id="vraag1-optie1" name="vraag1" value="Weekend trip (1-3 dagen)">
                    <label for="vraag1-optie1">Weekend trip (1-3 dagen)</label><br>
                    <input type="radio" id="vraag1-optie2" name="vraag1" value="Korte vakantie (4-7 dagen)">
                    <label for="vraag1-optie2">Korte vakantie (4-7 dagen)</label><br>
                    <input type="radio" id="vraag1-optie3" name="vraag1" value="Lange vakantie (8+ dagen)">
                    <label for="vraag1-optie3">Lange vakantie (8+ dagen)</label>
                </div>
                <br>
                <button type="button" onclick="volgendeVraag(1)">Volgende vraag</button>
            </div>

            <!-- Vraag 2 -->
            <div class="vraag" id="vraag2-container">
                <p class="vraag-teller" id="vraag-teller">Vraag 2 van 6</p>
                <label for="vraag2">Wat voor soort reis zoek je?</label>
                <br><br>
                <div id="vraag2">
                    <input type="radio" id="vraag2-optie1" name="vraag2" value="Cultuur & geschiedenis">
                    <label for="vraag2-optie1">Cultuur & geschiedenis</label><br>
                    <input type="radio" id="vraag2-optie2" name="vraag2" value="Uitgaan & festivals">
                    <label for="vraag2-optie2">Uitgaan & festivals</label><br>
                    <input type="radio" id="vraag2-optie3" name="vraag2" value="Natuur & ontspanning">
                    <label for="vraag2-optie3">Natuur & ontspanning</label><br>
                    <input type="radio" id="vraag2-optie4" name="vraag2" value="Shoppen & mode">
                    <label for="vraag2-optie4">Shoppen & mode</label><br>
                    <input type="radio" id="vraag2-optie5" name="vraag2" value="Food">
                    <label for="vraag2-optie5">Food</label>
                </div>
                <br>
                <button type="button" onclick="vorigeVraag(2)">⬅ Terug</button>
                <button type="button" onclick="volgendeVraag(2)">Volgende vraag</button>
            </div>

            <!-- Vraag 3 -->
            <div class="vraag" id="vraag3-container">
                <p class="vraag-teller" id="vraag-teller">Vraag 3 van 6</p>
                <label for="vraag3">Met wie reis je?</label>
                <br><br>
                <div id="vraag3">
                    <input type="radio" id="vraag3-optie1" name="vraag3" value="Alleen">
                    <label for="vraag3-optie1">Alleen</label><br>
                    <input type="radio" id="vraag3-optie2" name="vraag3" value="Met vrienden">
                    <label for="vraag3-optie2">Met vrienden</label><br>
                    <input type="radio" id="vraag3-optie3" name="vraag3" value="Met partner">
                    <label for="vraag3-optie3">Met partner</label><br>
                    <input type="radio" id="vraag3-optie4" name="vraag3" value="Met familie">
                    <label for="vraag3-optie4">Met familie</label>
                </div>
                <br>
                <button type="button" onclick="vorigeVraag(3)">⬅ Terug</button>
                <button type="button" onclick="volgendeVraag(3)">Volgende vraag</button>
            </div>

            <!-- Vraag 4 -->
            <div class="vraag" id="vraag4-container">
                <p class="vraag-teller" id="vraag-teller">Vraag 4 van 6</p>
                <label for="vraag4">Wat is je budget (per dag)?</label>
                <br><br>
                <div id="vraag4">
                    <input type="radio" id="vraag4-optie1" name="vraag4" value="Minder dan €30">
                    <label for="vraag4-optie1">Minder dan €30</label><br>
                    <input type="radio" id="vraag4-optie2" name="vraag4" value="€30 - €60">
                    <label for="vraag4-optie2">€30 - €60</label><br>
                    <input type="radio" id="vraag4-optie3" name="vraag4" value="Meer dan €60">
                    <label for="vraag4-optie3">Meer dan €60</label>
                </div>
                <br>
                <button type="button" onclick="vorigeVraag(4)">⬅ Terug</button>
                <button type="button" onclick="volgendeVraag(4)">Volgende vraag</button>

            </div>

            <!-- Vraag 5 -->
            <div class="vraag" id="vraag5-container">
                <p class="vraag-teller" id="vraag-teller">Vraag 5 van 6</p>
                <label for="vraag5">Wat is belangrijker voor je?</label>
                <br><br>
                <div id="vraag5">
                    <input type="radio" id="vraag5-optie1" name="vraag5" value="Comfort en luxe">
                    <label for="vraag5-optie1">Comfort en luxe</label><br>
                    <input type="radio" id="vraag5-optie2" name="vraag5" value="Betaalbaar maar leuke opties">
                    <label for="vraag5-optie2">Betaalbaar maar leuke opties</label><br>
                    <input type="radio" id="vraag5-optie3" name="vraag5" value="Dicht in de buurt van het centrum">
                    <label for="vraag5-optie3">Dicht in de buurt van het centrum</label>
                </div>
                <br>
                <button type="button" onclick="vorigeVraag(5)">⬅ Terug</button>
                <button type="button" onclick="volgendeVraag(5)">Volgende vraag</button>

            </div>


            <!-- Vraag 6 -->
            <div class="vraag" id="vraag6-container">
                <p class="vraag-teller">Vraag 6 van 6</p>
                <label for="vraag6">Hoe wil je reizen?</label>
                <br><br>
                <div id="vraag6">
                    <input type="radio" id="vraag6-optie1" name="vraag6" value="Met trein">
                    <label for="vraag6-optie1">Met trein</label><br>
                    <input type="radio" id="vraag6-optie2" name="vraag6" value="Met vliegtuig">
                    <label for="vraag6-optie2">Met vliegtuig</label><br>
                    <input type="radio" id="vraag6-optie3" name="vraag6" value="Met auto">
                    <label for="vraag6-optie3">Met auto</label>
                </div>
                <br>
                <button type="button" onclick="vorigeVraag(6)">⬅ Terug</button>
                <button type="button" class="volgende" onclick="toonOverzicht()">Toon overzicht</button>
            </div>

            <!-- Overzichtspagina -->
            <div class="vraag" id="overzichtContainer">
                <h2>Controleer je antwoorden</h2>
                <ul id="overzicht-lijst"></ul>
                <br>

                <button type="button" class="vorige" onclick="terugNaarVragen()">⬅️ Terug</button>
                <button type="submit" class="volgende">Verzenden</button>

        </form>
    </section>
    <footer>
        <%- include('../partials/footer'); %>
    </footer>

    <script src="script.js"></script>
</body>

</html>