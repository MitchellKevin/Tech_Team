<!DOCTYPE html>
<html lang="nl">
<head>
    <%- include('../partials/head'); %>
</head>

<body class="quizResult container">
    <header>
        <%- include('../partials/header'); %>
    </header>

    <div id="searchdiv">
        <div class="searchBar">
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#485EA1"><path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>
    
        <input type="search" class="search" placeholder="Waar ben je naar op zoek">
    
        <button>Zoek</button>
        </div>
    </div>
    
    <section class="matchResult">
        <h1>
            Jouw beste match - <span><%- randomDestination.city -%></span>
        </h1>

        <div class="matchResultdiv">
            <img class="fotoResult" src=<%- randomDestination.img -%> alt="">

            <div>
                <p>
                    <%- randomDestination.description -%> 
                </p>
                <p>
                    Geniet van heerlijke Italiaanse gerechten op sfeervolle pleinen en ervaar de unieke mix van oud en modern. Of je nu komt voor kunst, architectuur of gastronomie, Rome betovert elke bezoeker. Een reis naar deze tijdloze stad is een ervaring om nooit te vergeten!
                </p>
        
                <button>
                    Lees meer over <%- randomDestination.city -%>
                </button>
            </div>

        </div>
    </section>

    <!-- <section class="otherMatches">
        <h1>Andere matches</h1>

        <div class="cardScroll">

        

        </div>
    </section> -->
    
    <section class="otherMatches">
        <h2>Andere matches</h2>
        <div class="cardScroll">
            <% if (destinations && destinations.length > 0) { %>
              <% destinations.forEach(destination => { %>
                <article class="V3cityCard">
                  <div class="V3cityCardImage">
                    <img src="<%= destination.img %>" alt="<%= destination.city %>">
                    
                    <label class="heart" for="fav-<%= destination._id %>">
                      <input 
                        type="checkbox" 
                        id="fav-<%= destination._id %>" 
                        name="fav" 
                        value="<%= destination.city %>" 
                        <%= favorites.includes(destination.city) ? "checked" : "" %>
                      >
                      
                      <img src="../static/images/heart.svg" alt="Heart">
                      <img src="../static/images/heartfil.svg" alt="Heart Filled" class="heartFill">
                    </label>

                    <div class="V3cityCardButton">
                        <button class="cityButton2">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                            </svg>
                        </button>
                    
                        <img src="../static/images/buttonBackground4.svg" alt="">
                    </div> 
                  </div>

                  <div class="V3cityCardInfo">
                    <div class="V3cityCardTitle">
                      <h3><%= destination.city %></h3>
                      <p><%= destination.country %></p>
                    </div>
  
                </article>
              <% }) %>
            <% } else { %>
              <p>Geen bestemmingen gevonden.</p>
            <% } %>
        </div>
    </section>



    
    <footer>
        <%- include('../partials/footer'); %>
    </footer>

    <script src="../static/script.js"></script>
</body>
</html>
