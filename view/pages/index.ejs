<!DOCTYPE html>
<html lang="nl">
<head>
    <%- include('../partials/head'); %>
</head>

<body class="index container">
    <header>
        <%- include('../partials/header'); %>
    </header>

    <%- include('../partials/searchBar'); %>
    
    
    <section class="landing">
        <img src="../static/images/plane.png" alt="">

        <div>
            <div>
                <h1>
                    Start je reis
                </h1>
                <p>
                    Met onze matchingtool ontdek jij in een paar klikken welke stad het beste aansluit bij jouw interesses, budget en reisstijl.
                </p>
                <p>
                    Beantwoord een paar korte vragen en krijg een stad aanbevolen die bij jou past!
                </p>
            </div>
            
            <a href="/quiz">
              <button>
                Vind jouw perfecte stad!
            </button>
            </a>
        </div>
        
    </section>

    <section class="polaroids">
        <h2>
            Top <span>Bestemmingen</span>
        </h2>
        <p>De meest gezochte steden</p>

        <div>
          <a href="/result?city=Paris">
            <img class = "polaroid" src="../static/images/polaroid.png" alt="">
          </a>
          <a href="/result?city=Berlin">
            <img class = "polaroid" src="../static/images/polaroid2.png" alt="">
          </a>
          <a href="/result?city=London">
            <img class = "polaroid" src="../static/images/polaroid3.png" alt="">
          </a>
        </div>
    </section>

    <section class="aanbevolen">
        <h2>Aanbevolen voor jou</h2>
        <div class="gridContainer">
            <div class="cityCard1">
                <img src="../static/images/amsterdam.png" alt="">
                <div class="gradientOverlay"></div>

                <p class="cityInfo">Amsterdam</p>

                <a href="/result?city=Amsterdam">
                  <button class="cityButton">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                    </svg>
                    </button>
                  </a>
            </div>

            <div class="cityCard2">
                <img src="../static/images/parijs.png" alt="">
                <div class="gradientOverlay"></div>

                <p class="cityInfo">Parijs</p>
                
                <button class="cityButton" href="/result?city=Paris">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                  </button>
            </div>

            <div class="cityCard3">
                <img src="../static/images/berlijn.png" alt="">
                <div class="gradientOverlay"></div>

                <p class="cityInfo">Berlijn</p>
                
                <button class="cityButton" href="/result?city=Berlin">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                  </button>
            </div>

            <div class="cityCard4">
                <img src="../static/images/destinations/kopenhagen.jpeg" alt="">
                <div class="gradientOverlay"></div>

                <p class="cityInfo">Copenhagen</p>
                
                <button class="cityButton" href="/result?city=Copenhagen">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                  </button>
            </div>

            <div class="cityCard5">
                <img src="../static/images/london.png" alt="">
                <div class="gradientOverlay"></div>

                <p class="cityInfo">London</p>
                
                <button class="cityButton" href="/result?city=London">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                  </button>
            </div>

            <div class="cityCard6">
                <img src="../static/images/destinations/helsinki.jpg" alt="">
                <div class="gradientOverlay"></div>

                <p class="cityInfo">Helsinki</p>
                
                <button class="cityButton" href="/result?city=Helsinki">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                </button>
            </div>
        </div>

        <!-- <a href="/friendlist">
            <p>Ga naar jouw matches</p>
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#485EA1"><path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/></svg>
        </a> -->
    </section>

    <section class="aboutUs">
        <h2>Wat is FlyEasy?</h2>
        <div class="aboutusdivp">
            <p>
                Wij hebben dit platform hebben gemaakt, zodat iedereen de perfecte stad kan vinden!
            </p>

            <p>
                We geloven dat reizen meer is dan alleen bestemmingen kiezen; het gaat om ontdekken, verbinden en beleven. Daarom helpen we studenten zoals jij de ideale stad te vinden op basis van jouw voorkeuren, interesses en budget
            </p>
        </div>
        

        <div class="aboutUsDiv">
            <div>
                <img src="../static/images/aboutUs.png" alt="">
                <p>Persoonlijke Reismatching</p>
            </div>

            <div>
                <img src="../static/images/aboutUs1.png" alt="">
                <p>Betaalbaar Reizen</p>
            </div>

            <div>
                <img src="../static/images/aboutUs2.png" alt="">
                <p>Community & Ervaringen</p>
            </div>
        </div>
    </section>

    <section class="gids">
        <h2>Gids</h2>
        <div class="cardScroll">
            <% if (destinations && destinations.length > 0) { %>
              <% destinations.forEach(destination => { %>
                <article class="V3cityCard">
                  <div class="V3cityCardImage">
                    <img src="<%= destination.img %>" alt="<%= destination.city %>">
                    
                    <label class="heart" for="fav-<%= destination._id %>">
                      <input 
                        type="checkbox" 
                        id="fav-<%= destination._id %>" 
                        name="fav" 
                        value="<%= destination.city %>" 
                        <%= favorites.includes(destination.city) ? "checked" : "" %>
                      >
                      
                      <img src="../static/images/heart.svg" alt="Heart">
                      <img src="../static/images/heartfil.svg" alt="Heart Filled" class="heartFill">
                    </label>

                    <div class="V3cityCardButton">
                      <a href="/result?city=<%= destination.city %>">
                        <button class="cityButton2" href="/result?city=amsterdam>">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                            </svg>
                        </button>
                      </a>
                    
                        <img src="../static/images/buttonBackground4.svg" alt="">
                    </div> 
                  </div>

                  <div class="V3cityCardInfo">
                    <div class="V3cityCardTitle">
                      <h3><%= destination.city %></h3>
                      <p><%= destination.country %></p>
                    </div>
  
                </article>
              <% }) %>
            <% } else { %>
              <p>Geen bestemmingen gevonden.</p>
            <% } %>
        </div>
    </section>


    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('input[type="checkbox"]').forEach((checkbox) => {
          checkbox.addEventListener('change', async (event) => {
            const city = event.target.value; 
            const checked = event.target.checked; 

            try {
              const response = await fetch('/fav', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({ city, checked })
              });

              if (!response.ok) {
                if (response.status === 401) {
                  alert("Je moet ingelogd zijn om een stad te liken.");
                }
                throw new Error("Er is een fout opgetreden.");
              }

              const data = await response.json();
              console.log('Favorites updated:', data);

            } catch (error) {
              console.error('Error updating favorites:', error);

              event.target.checked = !checked;
            }
          });
        });
      });
    </script>
    
    <footer>
        <%- include('../partials/footer'); %>
    </footer>

    <script src="../static/script.js"></script>
</body>
</html>
