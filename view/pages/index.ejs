<!DOCTYPE html>
<html lang="nl">
<head>
    <%- include('../partials/head'); %>
</head>

<body class="index container">
    <header>
        <%- include('../partials/header'); %>
    </header>
    
    <section class="landing">
        <h1>
            Start je reis
        </h1>
        <img src="../static/images/plane.png" alt="">
        <p>
            Met onze matchingtool ontdek jij in een paar klikken welke stad het beste aansluit bij jouw interesses, budget en reisstijl.
            
            Beantwoord een paar korte vragen en krijg een stad aanbevolen die bij jou past!
        </p>

        <button>
            Vind jouw perfecte stad!
        </button>
    </section>

    <section class="polaroids">
        <h1>
            Top <span>Bestemmingen</span>
        </h1>
        <p>De meest gezochte steden</p>

        <div>
            <img class = "polaroid" src="../static/images/polaroid.png" alt="">
            <img class = "polaroid" src="../static/images/polaroid.png" alt="">
            <img class = "polaroid" src="../static/images/polaroid.png" alt="">
        </div>
    </section>

    <section class="grid">
        <h1>Aanbevolen voor jou</h1>
        <div>
            <div>
                <img src="../static/images/amsterdam.png" alt="">
                <button class="arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                  </button>
            </div>
        </div>
    </section>



    
    <footer>
        <%- include('../partials/footer'); %>
    </footer>

    <script src="../static/script.js"></script>
</body>
</html>
