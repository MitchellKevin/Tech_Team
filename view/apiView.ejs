<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <title>API via AJAX</title>
</head>
<body>
  <h1>API Resultaten</h1>
  <div id="api-results"></div>
  
  <script>
    async function fetchApiData() {
      try {
        const response = await fetch('/api-results');
        if (!response.ok) {
          throw new Error("Fout tijdens ophalen van data");
        }
        // Stel dat de route JSON retourneert:
        const data = await response.json();
        // Weergeven in de div
        document.getElementById('api-results').innerHTML = 
          `<pre>${JSON.stringify(data, null, 2)}</pre>`;
      } catch (error) {
        console.error(error);
        document.getElementById('api-results').textContent = "Er is een fout opgetreden bij het ophalen van de data.";
      }
    }
    fetchApiData();
  </script>
</body>
</html>