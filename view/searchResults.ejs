<body class="searchBody container">
    <header>
        <%- include('./partials/header'); %>
    </header>

    
    <section class="searchResultImg">
        <img src="../static/images/amsterdam.png" alt="">

        <div class="gradientOverlay2">
        </div>

        <div>
            <p>zoekresultaat:</p>
            <h1>"<%= query %>"</h1>
        </div>
    </section>

    <%- include('./partials/searchBar'); %>
    
    <section id="theList" class="searchResult">
        <div class="sorteren">
            <button class="sort" data-sort="name" data-default-order='asc'>naam</button>

            <!-- <div class="filtering">
                <div>
                    <input type="radio" name="filter" value="all" id="filter-all" checked>
                    <label for="filter-all">alles</label>
                </div>
    
                <div>
                    <input type="radio" name="filter" value="food" id="filter-food">
                    <label for="filter-people">food</label>
                </div>
    
                <div>
                    <input type="radio" name="filter" value="cultural" id="filter-cultural">
                    <label for="filter-cultural">cultural</label>
                </div>
    
                <div>
                    <input type="radio" name="filter" value="historical" id="filter-historical">
                    <label for="filter-historical">historical</label>
                </div> -->
            </div>
        </div>


          
        <div>
            <% if (results.length > 0) { %>
                <ul class="searchResultdiv list all">
                    <% results.forEach(result => { %>
                        <!-- <li>
                            <h2 class="name"><%= result.city %> (<%= result.country %>)</h2>
                            <p><%= result.description %></p>
                            <% if (result.img) { %>
                            <img src="<%= result.img %>" alt="<%= result.city %>" style="max-width: 300px;">
                            <% } %>
                        </li> -->

                        <li>
                            <article class="V3cityCard">
                                <div class="V3cityCardImage">
                                    <% if (result.img) { %>
                                    <img src="<%= result.img %>" alt="<%= result.city %>" style="max-width: 300px;">
                                    <% } %>
                            
                            
                                    <label class="heart" for="fav-rome">
                                        <input type="checkbox">
                                        <img src="../static/images/heart.svg" alt="">
                                    </label>
                            
                                    <label class="heart">
                                        <input type="checkbox">
                                        <img src="../static/images/heart.svg" alt="">
                                    </label>
                            
                                    <button class="heartFill">
                                        <img src="../static/images/heartfil.svg" alt="">
                                    </button>
                            
                                    <div class="V3cityCardButton">
                                        <a href="/result?city=<%= result.city %>">
                                            <button class="cityButton2">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
                                                </svg>
                                            </button>
                                        </a>
                                        <img src="../static/images/buttonBackground4.svg" alt="">
                                    </div>                  
                                </div>
                            
                                <div class="V3cityCardInfo">
                                    <div class="V3cityCardTitle">
                                        <h3 class="name"><%= result.city %> (<%= result.country %>)</h3>
                            
                                    </div>
                            
                                    <!-- <p><%= result.description %></p> -->
                                </div>
                            </article>
                        </li>
                        
                            <% }) %>
                </ul>
                
                    <% } else { %>
                        <p>No results found for "<%= query %>".</p>
                    <% } %>
        </div>
    </section>

