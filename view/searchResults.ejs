<!DOCTYPE html>
<html lang="nl">
<head>
    <%- include('./partials/head'); %>
</head>

<body class="searchBody container">
    <header>
        <%- include('./partials/header'); %>
    </header>

    
    <section class="searchResultImg">
        <img src="../static/images/amsterdam.png" alt="">

        <div class="gradientOverlay2">
        </div>

        <div>
            <p>zoekresultaat:</p>
            <h1>"<%= query %>"</h1>
        </div>


    </section>

    <%- include('./partials/searchBar'); %>
    
    <section id="theList" class="searchResult">
        <div class="sorteren">
            <button class="sort" data-sort="name" data-default-order='asc'>naam</button>
        </div>

        <div>
            <div>
                <input type="radio" name="filter" value="all" id="filter-all" checked>
                <label for="filter-all">alles</label>
            </div>

            <div>
                <input type="radio" name="filter" value="food" id="filter-food">
                <label for="filter-people">food</label>
            </div>

            <div>
                <input type="radio" name="filter" value="cultural" id="filter-cultural">
                <label for="filter-cultural">cultural</label>
            </div>

            <div>
                <input type="radio" name="filter" value="historical" id="filter-historical">
                <label for="filter-historical">historical</label>
            </div>
        </div>
          
        <div class="searchResultdiv">
            <% if (results.length > 0) { %>
                <ul class="list" class="all">
                    <% results.forEach(result => { %>
                        <li>
                            <h2 class="name"><%= result.city %> (<%= result.country %>)</h2>
                            <p><%= result.description %></p>
                            <% if (result.img) { %>
                            <img src="<%= result.img %>" alt="<%= result.city %>" style="max-width: 300px;">
                            <% } %>
                        </li>
                            <% }) %>
                </ul>
                
                    <% } else { %>
                        <p>No results found for "<%= query %>".</p>
                    <% } %>
        </div>
    </section>

